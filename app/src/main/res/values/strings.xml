    <!-- Plain-language Privacy & Data Safety -->
    <string name="privacy_what_is_stored_title">What is stored</string>
    <string name="privacy_what_is_stored_desc">Your stars, scores, answer history, review cards and settings are saved only on this phone.</string>
    <string name="privacy_retention_title">How long we keep it</string>
    <string name="privacy_retention_desc">By default, your detailed answer history is kept for 30 days. You can change this below to 30 days, 90 days or until you delete it. Stars, scores and review cards stay until you delete them.</string>
    <string name="privacy_never_collected_title">What is never collected</string>
    <string name="privacy_never_collected_desc">QuizQuest does not collect or transmit personal names, email addresses, advertising IDs, location data, or analytics telemetry.</string>
    <string name="privacy_opentdb_title">Network requests &amp; OpenTDB</string>
    <string name="privacy_opentdb_desc">Questions are fetched directly from opentdb.com via HTTPS. OpenTDB servers see standard network HTTP requests including your IP address, but no user identifiers or account data are sent.</string>
    <string name="privacy_backups_title">Backups</string>
    <string name="privacy_backups_desc">Your data is not included in cloud backups. Use Export to keep your own copy.</string>
    <string name="privacy_mistakes_title">Questions may contain mistakes</string>
    <string name="privacy_mistakes_desc">Questions are written by the Open Trivia Database community and may contain mistakes. Tap the flag on a question to report it – it is then hidden on this phone. Reports are not sent anywhere.</string>
    <string name="privacy_attribution_title">Data source &amp; attribution</string>
    <string name="privacy_attribution_desc">Trivia question content is provided by the Open Trivia Database (opentdb.com) under Creative Commons Attribution-ShareAlike 4.0 International (CC BY-SA 4.0).</string>
    <string name="privacy_feedback_title">Feedback &amp; Support</string>
    <string name="privacy_feedback_desc">Have questions or suggestions? Send feedback directly to the developers.</string>
    <string name="privacy_send_feedback">Send feedback</string>
